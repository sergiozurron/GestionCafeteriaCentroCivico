CREATE TABLE BOSALA (ID INTEGER AUTO_INCREMENT NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, CAPACIDAD INTEGER, NOMBRE VARCHAR(255), VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOCLASE (ID INTEGER AUTO_INCREMENT NOT NULL, ACTIVO TINYINT(1) default 0, DURACION INTEGER, FECHAINICIO DATETIME, TIPO VARCHAR(255), VERSION INTEGER, sala_id INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOMATERIAL (ID INTEGER AUTO_INCREMENT NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, AUTOR VARCHAR(255), NOMBRE VARCHAR(255), TIPOMATERIAL INTEGER, VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOLIBRO (ID INTEGER NOT NULL, EDITORIAL VARCHAR(255), ISBN INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOPINTURA (ID INTEGER NOT NULL, FECHA VARCHAR(255), NUMERO INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOEJEMPLAR (ID INTEGER AUTO_INCREMENT NOT NULL, ACTIVO TINYINT(1) default 0, ESTADO VARCHAR(255), VERSION INTEGER, material_id INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOCLASE_BOEJEMPLAR (clases_ID INTEGER NOT NULL, ejemplares_ID INTEGER NOT NULL, PRIMARY KEY (clases_ID, ejemplares_ID))
ALTER TABLE BOCLASE ADD CONSTRAINT FK_BOCLASE_sala_id FOREIGN KEY (sala_id) REFERENCES BOSALA (ID)
ALTER TABLE BOLIBRO ADD CONSTRAINT FK_BOLIBRO_ID FOREIGN KEY (ID) REFERENCES BOMATERIAL (ID)
ALTER TABLE BOPINTURA ADD CONSTRAINT FK_BOPINTURA_ID FOREIGN KEY (ID) REFERENCES BOMATERIAL (ID)
ALTER TABLE BOEJEMPLAR ADD CONSTRAINT FK_BOEJEMPLAR_material_id FOREIGN KEY (material_id) REFERENCES BOMATERIAL (ID)
ALTER TABLE BOCLASE_BOEJEMPLAR ADD CONSTRAINT FK_BOCLASE_BOEJEMPLAR_ejemplares_ID FOREIGN KEY (ejemplares_ID) REFERENCES BOEJEMPLAR (ID)
ALTER TABLE BOCLASE_BOEJEMPLAR ADD CONSTRAINT FK_BOCLASE_BOEJEMPLAR_clases_ID FOREIGN KEY (clases_ID) REFERENCES BOCLASE (ID)
