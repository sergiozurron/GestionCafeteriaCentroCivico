CREATE TABLE BOSOCIO (ID INTEGER AUTO_INCREMENT NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, CUOTA INTEGER, DNI VARCHAR(255), NOMBREYAPELLIDO VARCHAR(255), TIPOSOCIO INTEGER, VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOADULTO (ID INTEGER NOT NULL, MIEMBROPLENO TINYINT(1) default 0, PRIMARY KEY (ID))
CREATE TABLE BOINFANTIL (ID INTEGER NOT NULL, EDAD INTEGER, REDUCCION DOUBLE, PRIMARY KEY (ID))
CREATE TABLE BOPROMOCION (ID INTEGER AUTO_INCREMENT NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, DESCUENTO DOUBLE, TIPO VARCHAR(255), VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOPRESTAMO (ID INTEGER AUTO_INCREMENT NOT NULL, ACTIVO TINYINT(1) default 0, FECHADEVUELTO DATE, FECHAINICIAL DATE, FECHAMAXIMA DATE, PRECIOMULTA DOUBLE, VERSION INTEGER, ejemplar_id INTEGER, socio_id INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOMATERIAL (ID INTEGER AUTO_INCREMENT NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, AUTOR VARCHAR(255), NOMBRE VARCHAR(255), TIPOMATERIAL INTEGER, VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOLIBRO (ID INTEGER NOT NULL, EDITORIAL VARCHAR(255), ISBN INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOPINTURA (ID INTEGER NOT NULL, FECHA VARCHAR(255), NUMERO INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOEJEMPLAR (ID INTEGER AUTO_INCREMENT NOT NULL, ACTIVO TINYINT(1) default 0, ESTADO VARCHAR(255), VERSION INTEGER, material_id INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOSALA (ID INTEGER AUTO_INCREMENT NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, CAPACIDAD INTEGER, NOMBRE VARCHAR(255), VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOCLASE (ID INTEGER AUTO_INCREMENT NOT NULL, ACTIVO TINYINT(1) default 0, DURACION INTEGER, FECHAINICIO DATETIME, TIPO VARCHAR(255), VERSION INTEGER, sala_id INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOSOCIO_BOPROMOCION (socios_ID INTEGER NOT NULL, promocion_ID INTEGER NOT NULL, PRIMARY KEY (socios_ID, promocion_ID))
CREATE TABLE BOCLASE_BOEJEMPLAR (ejemplares_ID INTEGER NOT NULL, clases_ID INTEGER NOT NULL, PRIMARY KEY (ejemplares_ID, clases_ID))
ALTER TABLE BOADULTO ADD CONSTRAINT FK_BOADULTO_ID FOREIGN KEY (ID) REFERENCES BOSOCIO (ID)
ALTER TABLE BOINFANTIL ADD CONSTRAINT FK_BOINFANTIL_ID FOREIGN KEY (ID) REFERENCES BOSOCIO (ID)
ALTER TABLE BOPRESTAMO ADD CONSTRAINT FK_BOPRESTAMO_socio_id FOREIGN KEY (socio_id) REFERENCES BOSOCIO (ID)
ALTER TABLE BOPRESTAMO ADD CONSTRAINT FK_BOPRESTAMO_ejemplar_id FOREIGN KEY (ejemplar_id) REFERENCES BOEJEMPLAR (ID)
ALTER TABLE BOLIBRO ADD CONSTRAINT FK_BOLIBRO_ID FOREIGN KEY (ID) REFERENCES BOMATERIAL (ID)
ALTER TABLE BOPINTURA ADD CONSTRAINT FK_BOPINTURA_ID FOREIGN KEY (ID) REFERENCES BOMATERIAL (ID)
ALTER TABLE BOEJEMPLAR ADD CONSTRAINT FK_BOEJEMPLAR_material_id FOREIGN KEY (material_id) REFERENCES BOMATERIAL (ID)
ALTER TABLE BOCLASE ADD CONSTRAINT FK_BOCLASE_sala_id FOREIGN KEY (sala_id) REFERENCES BOSALA (ID)
ALTER TABLE BOSOCIO_BOPROMOCION ADD CONSTRAINT FK_BOSOCIO_BOPROMOCION_promocion_ID FOREIGN KEY (promocion_ID) REFERENCES BOPROMOCION (ID)
ALTER TABLE BOSOCIO_BOPROMOCION ADD CONSTRAINT FK_BOSOCIO_BOPROMOCION_socios_ID FOREIGN KEY (socios_ID) REFERENCES BOSOCIO (ID)
ALTER TABLE BOCLASE_BOEJEMPLAR ADD CONSTRAINT FK_BOCLASE_BOEJEMPLAR_ejemplares_ID FOREIGN KEY (ejemplares_ID) REFERENCES BOEJEMPLAR (ID)
ALTER TABLE BOCLASE_BOEJEMPLAR ADD CONSTRAINT FK_BOCLASE_BOEJEMPLAR_clases_ID FOREIGN KEY (clases_ID) REFERENCES BOCLASE (ID)
