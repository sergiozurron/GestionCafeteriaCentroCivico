<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	version="3.0">
	<persistence-unit name="CentroCivicoJPA" transaction-type="RESOURCE_LOCAL">
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

		<class>com.grupoms.app.negocio.socioJPA.BOSocio</class>
		<class>com.grupoms.app.negocio.socioJPA.BOAdulto</class>
		<class>com.grupoms.app.negocio.socioJPA.BOInfantil</class>

		<class>com.grupoms.app.negocio.PromocionJPA.BOPromocion</class>
		<class>com.grupoms.app.negocio.prestamoJPA.BOPrestamo</class>
		<class>com.grupoms.app.negocio.materialJPA.BOMaterial</class>
		<class>com.grupoms.app.negocio.materialJPA.BOLibro</class>
		<class>com.grupoms.app.negocio.materialJPA.BOPintura</class>
		<class>com.grupoms.app.negocio.EjemplarJPA.BOEjemplar</class>
		<class>com.grupoms.app.negocio.salaJPA.BOSala</class>
		<class>com.grupoms.app.negocio.ClaseJPA.BOClase</class>

		<properties>
			<property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver" />
			<property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:test;DB_CLOSE_DELAY=-1" />
			<property name="jakarta.persistence.jdbc.user" value="sa" />
			<property name="jakarta.persistence.jdbc.password" value="" />

			<property name="eclipselink.logging.level" value="FINE" />
			<property name="eclipselink.ddl-generation" value="create-tables" />
			<property name="eclipselink.ddl-generation.output-mode" value="database" />
		</properties>
	</persistence-unit>
</persistence>
