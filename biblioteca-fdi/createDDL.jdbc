CREATE TABLE BOMATERIAL (ID INTEGER AUTO_INCREMENT NOT NULL, DTYPE VARCHAR(31), ACTIVO TINYINT(1) default 0, AUTOR VARCHAR(255), NOMBRE VARCHAR(255), TIPOMATERIAL INTEGER, VERSION INTEGER, PRIMARY KEY (ID))
CREATE TABLE BOLIBRO (ID INTEGER NOT NULL, EDITORIAL VARCHAR(255), ISBN VARCHAR(255), PRIMARY KEY (ID))
CREATE TABLE BOPINTURA (ID INTEGER NOT NULL, FECHA VARCHAR(255), NUMERO INTEGER, PRIMARY KEY (ID))
ALTER TABLE BOLIBRO ADD CONSTRAINT FK_BOLIBRO_ID FOREIGN KEY (ID) REFERENCES BOMATERIAL (ID)
ALTER TABLE BOPINTURA ADD CONSTRAINT FK_BOPINTURA_ID FOREIGN KEY (ID) REFERENCES BOMATERIAL (ID)
